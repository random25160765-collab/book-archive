file<hpp> lru_wtinylfu += << 拼装 >>;
~::

规则 6 现在分两段：先无条件进窗口，再从窗口挤出来时才有条件地进 main。规则 7 也从一次判定变成两处淘汰——窗口自己挤，main 靠准入。

容量 4，窗口 1 格，试用区 1 格。`put(1)`、`get(1)` 三次（频率 4），然后 `put(2)`、`put(3)`、`put(4)`：

```
seq   1:. 2:Y 3:Y 4:Y // LRU：淘汰 1
wtl   1:Y 2:. 3:. 4:Y // W-TinyLFU：2、3 各被窗口放行一次，都被 1 挡住
```

注意 `size` 只有 2，缓存没被填满。这不是 bug：三个条目都从窗口出来，都撞上频率 4 的 1，全被拒。窗口的容量决定了“同时能有多少个新人排队”，窗口越小，准入越严。

窗口 1 格是为了让例子两步就出结果。真实配置是主容量的 1%，main 再按 2:8 分试用区和保护区。这三个比例是 W-TinyLFU 唯一的调参项，其余全是定死的机制——这正是它比 ARC 好部署的地方。

## 混合比：ARC

前面几个方案都在回答“recency 和 frequency 各占多少”。2Q 用 `ki_` 回答，W-TinyLFU 用窗口和试用区的大小回答，都是**事先定死的数**。

问题是这个数取决于负载。扫描型负载要 recency，反复访问型负载要 frequency，同一个进程在不同时段可能两种都有。定死的比例总有一半时间是错的。

ARC 把这个问题交给运行时的自己：不预设比例，让“淘汰错了的后悔”来调。

它维护四个队列。T1 放只被访问过一次的条目，T2 放至少两次的。B1 和 B2 是影子，只存 key：

| 队列 | 内容 | 在内存里 |
|---|---|---|
| T1 | 一次访问 | 值在 |
| T2 | 两次以上 | 值在 |
| B1 | 从 T1 淘汰的 | 只有 key |
| B2 | 从 T2 淘汰的 | 只有 key |

参数 `p` 是 T1 的目标大小。淘汰时看 `|T1|` 和 `p` 的关系：`|T1|` 超了就从 T1 尾砍，否则从 T2 尾砍。

自适应发生在影子命中：一个 key 从 B1 被再次访问，说明“当初把它从 T1 淘汰是错的”，于是 `p` 加一，T1 下次多留一会儿。从 B2 命中则反过来，`p` 减一。

!! arc::
<< 定义 >>= @
	using List = std::list<K>;
	using Iter = typename List::iterator;

	std::size_t cap_;
	std::size_t p_ = 0;                  // T1 的目标大小，唯一的动态参数
	std::unordered_map<K, V> val_;
	List t1_, t2_, b1_, b2_;
	std::unordered_map<K, Iter> t1p_, t2p_, b1p_, b2p_;
~@

<< 更新 >>= @
	bool full() const { return t1_.size() + t2_.size() >= cap_; }

	void replace(bool in_b2) {
		if (!t1_.empty() && (t1_.size() > p_ || (in_b2 && t1_.size() == p_))) {
			K k = t1_.back();            // 从 T1 尾砍：它是一次访问的
			t1_.pop_back();
			t1p_.erase(k);
			val_.erase(k);
			b1_.push_front(k);           // 只留 key 进影子
			b1p_[k] = b1_.begin();
		} else if (!t2_.empty()) {
			K k = t2_.back();            // 从 T2 尾砍：它是多次访问的
			t2_.pop_back();
			t2p_.erase(k);
			val_.erase(k);
			b2_.push_front(k);
			b2p_[k] = b2_.begin();
		}
	}

	void push_t2(const K& k, V v) {
		val_[k] = std::move(v);
		t2_.push_front(k);
		t2p_[k] = t2_.begin();
	}
~@

`replace` 里的 `in_b2` 那个条件就是自适应的落点：从 B2 回来时，即使 `|T1|` 正好等于 `p`，也优先砍 T1——因为 B2 命中意味着 frequency 那边更值得保护。

<< get >>= @
	std::optional<V> get(const K& k) {
		if (auto p = t1p_.find(k); p != t1p_.end()) {  // T1 命中 → 升 T2
			V v = val_.at(k);
			t1_.erase(p->second);
			t1p_.erase(p);
			push_t2(k, v);
			return v;
		}
		if (auto p = t2p_.find(k); p != t2p_.end()) {
			t2_.splice(t2_.begin(), t2_, p->second);
			return val_.at(k);
		}
		return std::nullopt;                            // 影子命中不在这里
	}
~@

<< put >>= @
	void put(const K& k, V v) {
		if (auto p = t1p_.find(k); p != t1p_.end()) {
			t1_.erase(p->second);
			t1p_.erase(p);
			push_t2(k, std::move(v));
			return;
		}
		if (auto p = t2p_.find(k); p != t2p_.end()) {
			val_[k] = std::move(v);
			t2_.splice(t2_.begin(), t2_, p->second);
			return;
		}
		if (b1p_.count(k)) {                 // B1 命中：T1 该更大
			if (p_ < cap_) ++p_;
			b1_.erase(b1p_.at(k));
			b1p_.erase(k);
			while (full()) replace(false);
			push_t2(k, std::move(v));
			return;
		}
		if (b2p_.count(k)) {                 // B2 命中：T2 该更大
			if (p_ > 0) --p_;
			b2_.erase(b2p_.at(k));
			b2p_.erase(k);
			while (full()) replace(true);
			push_t2(k, std::move(v));
			return;
		}
		while (full()) replace(false);       // 全新条目
		val_[k] = std::move(v);
		t1_.push_front(k);
		t1p_[k] = t1_.begin();
	}
~@

