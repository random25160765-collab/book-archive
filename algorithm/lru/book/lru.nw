	#include <cstddef>
	#include <list>
	#include <optional>
	#include <unordered_map>
	#include <utility>

	namespace tq {

	template <class K, class V>
	class Cache {
		<< 定义 >> | << 更新 >>
	public:
		Cache(std::size_t cap, std::size_t ki, std::size_t kout)
		    : cap_(cap), ki_(ki), kout_(kout) {}
		<< get >> | << put >> | << size >> | << capacity >>
	};

	} // namespace tq
~@

file<hpp> lru_tq += << 2Q模型 >>;
~::

改动落在三条规则上。规则 3：`get` 命中 A1 不再只是记一笔，是把条目从 A1 搬到 Am——update 的语义从“挪位置”变成“换队列”。规则 6：`put` 新 key 不直接进缓存，先进 A1 候车。规则 7：淘汰优先砍 A1 的队头，A1 空了才动 Am 的尾部。

第 6 条改了什么？新条目进来时缓存早满了，但它进的是 A1，不是主结构。所以 2Q 的容量分成两段配额，`ki_` 给 A1，`cap_ - ki_` 给 Am。`ki_` 越小，越不信任新条目。

容量 4，A1 配额 2。`put(1)`、`get(1)`（升到 Am），然后 `put(2)`、`put(3)`、`put(4)`、`put(5)`：

```
seq   1:. 2:Y 3:Y 4:Y 5:Y // LRU：1 被四连击洗掉
tq    1:Y 2:. 3:. 4:Y 5:Y // 2Q：1 守在 Am，挨洗的只有 A1
```

LRU 里 1 号虽然刚被 `get` 过，随后四次 `put` 还是把它一路推到队尾，第五次就被砍了。2Q 里 2、3、4 全在 A1 排队，A1 只有两个位置，先进的两个被挤进影子，一个都没碰到 Am 里的 1。

强项是抗扫描，弱项也在这儿：`ki_` 设得小，突发流量会在 A1 里互相淘汰，看起来像“什么都没缓存”。但它没有 LFU 的历史包袱——它压根不记历史，只记到 2 为止，而 Am 内部是 LRU，冷掉的东西照样会沉底。

## 计数存储：TinyLFU

LFU 那一节留了一个问题没答：频率怎么在有限空间里存。

要给每个 key 挂一个 64 位计数，空间就和 key 的数量成正比——缓存本身已经有界了，可计数表还得给每个“曾经出现过的 key”留位置，包括早就被淘汰的。这是 LFU 的内存债。

TinyLFU 的答案是 **Count-Min Sketch**：一张 D 行 W 列的二维表，每格一个 4 位计数器。一个 key 不占固定的一格，而是哈希到每行一个位置，D 个位置一起记。查的时候取这 D 个值里最小的那个。

取最小是有道理的。哈希会碰撞，碰撞只会让计数变大，不会变小——别处来的访问蹭到了这一格。所以 D 个估计值里，每一个都是真实值的上界，取最小就是最紧的那个上界。这是概率数据结构的老套路：用可控的高估换固定空间。

空间是 `D × W × 4` 位，和 key 有多少个无关。代价是误差，误差由 W 和 D 决定，和缓存容量无关。

4 位有个硬上限：15。撞得多了，格子饱和，所有 key 的估计值都变成 15，频率就失去分辨力。所以必须老化：

!! tinylfu::
<< 定义 >>= @
	static constexpr std::size_t W = 64;   // 每行格数
	static constexpr std::size_t D = 4;    // 行数，即哈希函数个数
	static constexpr std::size_t AGE = 8;  // 每多少次访问做一次全局减半

	std::array<std::array<std::uint8_t, W>, D> c_{}; // 4 位计数，这里用 uint8 存
	std::size_t cap_;
	std::size_t ops_ = 0;
	std::list<std::pair<K, V>> order_;               // 主结构：LRU
	std::unordered_map<K, typename std::list<std::pair<K, V>>::iterator> pos_;
	std::hash<K> h_;
~@

<< 哈希 >>= @
	std::uint64_t hs(const K& k) const {
		std::uint64_t x = static_cast<std::uint64_t>(h_(k));
		x += 0x9e3779b97f4a7c15ull;                  // splitmix64：把弱哈希搅开
		x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ull;
		x = (x ^ (x >> 27)) * 0x94d049bb133111ebull;
		return x ^ (x >> 31);
	}

	std::size_t ix(std::uint64_t h, std::size_t i) const { return (h >> (i * 13)) % W; }
~@

这里必须搅一下。`std::hash<int>` 对整数是恒等映射，小整数右移十三位全是零，四行会全撞在同一格——sketch 立刻退化成“所有 key 一个计数”。splitmix64 把低位的信息摊到高位，四行才真的落在四个不同位置。

<< 计数 >>= @
	void bump(std::uint64_t h) {
		for (std::size_t i = 0; i < D; ++i) {
			auto& v = c_[i][ix(h, i)];
			if (v < 15) ++v;                 // 4 位饱和
		}
	}

	int est(std::uint64_t h) const {
		int m = 15;
		for (std::size_t i = 0; i < D; ++i) m = std::min<int>(m, c_[i][ix(h, i)]);
		return m;
	}

	void tick() {
		if (++ops_ % AGE) return;
		for (auto& row : c_)
			for (auto& v : row) v = static_cast<std::uint8_t>(v >> 1); // 全体减半
	}
~@

`tick` 是遗忘机制，也是这本书里第一次有“时间自己让状态变”的东西——LFU 的 count 只增不减，这里每 AGE 次访问全体右移一位，等于所有频率一起打折。老的历史追不上新的访问，包袱就被甩掉了。

真实的 TinyLFU 用 W-TinyLFU 里的墓碑机制做老化（每十万次访问重置一次），这里用固定间隔减半，机制一样，数字不同。

<< get >>= @
	std::optional<V> get(const K& k) {
		tick();
		bump(hs(k));                       // 未命中也记一笔
		auto p = pos_.find(k);
		if (p == pos_.end()) return std::nullopt; // 规则 4 变了：结构不动，计数动
		order_.splice(order_.begin(), order_, p->second);
		return p->second->second;
	}
~@

注意 `bump` 在 `find` 之前。未命中也计数，这是 TinyLFU 的关键：它要记住“这个 key 出现过”，即使这次没进来，下次它带着更高的频率再来。

<< put >>= @
	void put(const K& k, V v) {
		tick();
		bump(hs(k));
		auto p = pos_.find(k);
		if (p != pos_.end()) {             // 规则 5
			p->second->second = std::move(v);
			order_.splice(order_.begin(), order_, p->second);
			return;
		}
		if (order_.size() == cap_) {       // 规则 7 变成“比较”
			const K victim = order_.back().first;
			if (est(hs(k)) <= est(hs(victim))) return; // 准入被拒：什么都不做
			pos_.erase(victim);
			order_.pop_back();
		}
		order_.push_front({k, std::move(v)}); // 规则 6
		pos_[k] = order_.begin();
	}
~@

`put` 里那个 `return` 是全书第一次出现“写操作可以什么都不做”。前面所有模型的 `put` 保证条目进去，这里它可以拒绝——因为它先做了一次比较：新条目的频率打不打得过受害者。

这就是“准入”和“淘汰”的区别。淘汰是“满了我得砍一个”，准入是“你俩比一比，输的走”。LRU 永远让新的进来、让最旧的走；TinyLFU 让强的留下，不管谁更新。

<< 拼装 >>= @
	#pragma once

	#include <algorithm>
	#include <array>
	#include <cstddef>
	#include <cstdint>
	#include <list>
	#include <optional>
	#include <unordered_map>
	#include <utility>

	namespace tlf {

	template <class K, class V>
	class Cache {
		<< 定义 >> | << 哈希 >> | << 计数 >>
	public:
		explicit Cache(std::size_t cap) : cap_(cap) {}
		<< get >> | << put >>
		std::size_t size() const { return order_.size(); }
		std::size_t capacity() const { return cap_; }
	};

	} // namespace tlf
~@

file<hpp> lru_tinylfu += << 拼装 >>;
~::

规则对照：规则 6 不再是“插入”，而是“可能插入”；规则 7 的 min() 不再单独使用，它被拿去和新条目比较。规则 4 也被松了一点：`get` 未命中不动结构，但计数变了——所以“不留痕”这条在 TinyLFU 里只剩一半。

容量 3，`put(1)`、`get(1)` 三次（频率 4），`put(2)`、`put(3)`（频率各 1），再 `put(4)`：

```
seq   1:. 2:Y 3:Y 4:Y // LRU：淘汰 2，4 进来
tlf   1:Y 2:Y 3:Y 4:. // TinyLFU：4 的频率 1 打不过 1，被拒在门外
```

4 号输在“1 不大于 1”。要是改成 `>=`，它就能挤掉 2——但那等于说“一样强的新人优先”，扫描流会借着这个口子灌进来。所以必须是严格大于。

代价也很明显：一次性的热点永远进不来，哪怕它马上要被访问一百次。sketch 只记过去，不预测未来。

## 双轨：W-TinyLFU

TinyLFU 有一个要命的前提：新条目要和老条目比频率，可它刚出现，频率必然是 1。碰上缓存里随便一个频率 2 的条目，它就输了。于是新东西永远进不来——这叫冷启动饥饿。

W-TinyLFU 的办法是给新条目一条专用通道：一个很小的 **window LRU**（真实配置约 1% 容量）。新条目先无条件进窗口，在窗口里待着、被访问、把频率攒起来。窗口溢出时，挤出来的那个才有资格去和 main 区比。

所以它是两条轨：

- 窗口：纯 LRU，不看频率，负责吸收突发；
- main：SLRU（segmented LRU），分试用区 probation 和保护区 protected，负责长期驻留。

`get` 命中 probation 的条目，把它升到 protected——这是 main 内部的第二次筛选。

!! wtinylfu::
<< 定义 >>= @
	using List = std::list<std::pair<K, V>>;
	using Iter = typename List::iterator;

	std::size_t cap_, win_cap_, pcap_, qcap_;
	std::size_t ops_ = 0;
	std::array<std::array<std::uint8_t, 64>, 4> c_{}; // 和 TinyLFU 同一张 sketch
	List win_, prob_, prot_;
	std::unordered_map<K, Iter> wp_, pp_, rp_;
	std::hash<K> h_;
~@

哈希与计数和上一节逐字相同，这里直接沿用同一个实现：

<< 哈希 >>= @
	std::uint64_t hs(const K& k) const {
		std::uint64_t x = static_cast<std::uint64_t>(h_(k));
		x += 0x9e3779b97f4a7c15ull;
		x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ull;
		x = (x ^ (x >> 27)) * 0x94d049bb133111ebull;
		return x ^ (x >> 31);
	}

	std::size_t ix(std::uint64_t h, std::size_t i) const { return (h >> (i * 13)) % 64; }

	void bump(std::uint64_t h) {
		for (std::size_t i = 0; i < 4; ++i) {
			auto& v = c_[i][ix(h, i)];
			if (v < 15) ++v;
		}
	}

	int est(std::uint64_t h) const {
		int m = 15;
		for (std::size_t i = 0; i < 4; ++i) m = std::min<int>(m, c_[i][ix(h, i)]);
		return m;
	}

	void tick() {
		if (++ops_ % 8) return;
		for (auto& row : c_)
			for (auto& v : row) v = static_cast<std::uint8_t>(v >> 1);
	}
~@

准入只有一个入口：窗口溢出。

<< 更新 >>= @
	void admit(std::pair<K, V> cand) {
		if (prob_.size() < pcap_) {          // 试用区没满，直接进
			prob_.push_front(std::move(cand));
			pp_[prob_.front().first] = prob_.begin();
			return;
		}
		const K vic = prob_.back().first;    // 满则比较：候选 vs 试用区尾部
		if (est(hs(cand.first)) <= est(hs(vic))) return; // 打不过就丢
		pp_.erase(vic);
		prob_.pop_back();
		prob_.push_front(std::move(cand));
		pp_[prob_.front().first] = prob_.begin();
	}

	void demote() {
		while (prot_.size() > qcap_) {       // 保护区超编，降回试用区
			auto cand = std::move(prot_.back());
			prot_.pop_back();
			rp_.erase(cand.first);
			prob_.push_front(std::move(cand));
			pp_[prob_.front().first] = prob_.begin();
		}
	}
~@

`demote` 是 SLRU 的名字来源：保护区不是只进不出，超编的要退回试用区重新排队。这样 protected 里留的是“最近还在被访问”的那批，而不是“曾经很热”的那批。

<< get >>= @
	std::optional<V> get(const K& k) {
		tick();
		bump(hs(k));
		if (auto p = wp_.find(k); p != wp_.end()) {   // 窗口：纯 LRU
			win_.splice(win_.begin(), win_, p->second);
			return p->second->second;
		}
		if (auto p = pp_.find(k); p != pp_.end()) {   // 试用区命中 → 升保护
			V v = p->second->second;
			prob_.erase(p->second);
			pp_.erase(p);
			prot_.push_front({k, v});
			rp_[k] = prot_.begin();
			demote();
			return v;
		}
		if (auto p = rp_.find(k); p != rp_.end()) {   // 保护区：挪头
			prot_.splice(prot_.begin(), prot_, p->second);
			return p->second->second;
		}
		return std::nullopt;
	}
~@

<< put >>= @
	void put(const K& k, V v) {
		tick();
		bump(hs(k));
		if (auto p = wp_.find(k); p != wp_.end()) {
			p->second->second = std::move(v);
			win_.splice(win_.begin(), win_, p->second);
			return;
		}
		if (auto p = pp_.find(k); p != pp_.end()) { p->second->second = std::move(v); return; }
		if (auto p = rp_.find(k); p != rp_.end()) {
			p->second->second = std::move(v);
			prot_.splice(prot_.begin(), prot_, p->second);
			return;
		}
		win_.push_front({k, std::move(v)});           // 规则 6 第一段：无条件进窗口
		wp_[k] = win_.begin();
		while (win_.size() > win_cap_) {              // 窗口溢出才走准入
			auto cand = std::move(win_.back());
			win_.pop_back();
			wp_.erase(cand.first);
			admit(std::move(cand));
		}
	}
~@

