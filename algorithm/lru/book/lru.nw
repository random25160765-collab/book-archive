		<< 构造 >>
		<< get >> | << put >> | << size >> | << capacity >>
	};

	} // namespace lrk
~@

file<hpp> lru_k += << LRUK模型 >>;
~::

改动只有一处：规则 3、5 里的 update，从“覆盖一个时刻”变成“往窗口里挤一个时刻”。规则 7 的 min() 还是取最小，只是比较的不再是单一时刻，是 `rank` 这个二元组。九条外部规则全在。

把扫描喂进去看。容量 3，K = 2，前三条各访问两次（攒够 K），然后 `put(4)`、`put(5)`：

```
seq   1:. 2:. 3:Y 4:Y 5:Y // LRU：两刀砍掉 1 和 2
lr2k  1:. 2:Y 3:Y 4:. 5:Y // LRU-K：4 历史不足，第二刀就出局
```

4 号只被访问过一次——`put` 那次。它的 rank 是 (0, t)，2、3 的 rank 是 (1, t')，0 < 1，所以第二刀必然砍 4。扫描流进不来，这正是 LRU-K 要的效果。

代价也在这儿：任何新条目都得先攒够 K 次才能上桌，冷启动和突发访问都变迟钝。K 是个旋钮，往小拧像 LRU，往大拧就越来越只认“反复出现”。它不是换成 frequency，是把 recency 的记忆从一次拉到 K 次。

## 决定时机：2Q

前面每一节改的都是“淘汰谁”。2Q 改的是另一件事：谁有资格进来。

它由三个队列组成。A1 是 FIFO，新条目先进这里；Am 是 LRU，被第二次访问的条目从 A1 升上来；A1out 是影子队列，只存 key 不存值，记录“最近从 A1 出去过”的那些。

于是“这个 key 被访问过几次”这件事，不用计数器也记得住，靠位置记：

| 位置 | 含义 | 粗糙的计数 |
|---|---|---|
| 不在任何队列 | 没见过 | 无 |
| A1out | 来过，已经走了 | 0 |
| A1 | 来过一次，还在候车 | 1 |
| Am | 来过至少两次 | 2 |

这就是“计数换成位置”。代价是粒度：只知道 0、1、2，再多的次数分不出来。收益是空间：A1out 存 key 不存 value，比给每条挂一个 64 位计数器便宜得多，淘汰它的代价也几乎为零。

A1 用 FIFO 而不是 LRU，同样是这个道理：A1 里的条目都只被碰过一次，没有新旧之分，FIFO 更便宜，而且它本来只是个候车室。

!! twoq::
<< 定义 >>= @
	using A1    = std::list<std::pair<K, V>>; // 候车：FIFO
	using A1It  = typename A1::iterator;
	using Am    = std::list<K>;               // 热区：LRU
	using AmIt  = typename Am::iterator;
	using Out   = std::list<K>;               // 影子：只有 key
	using OutIt = typename Out::iterator;

	std::size_t cap_, ki_, kout_;
	A1 a1_;
	std::unordered_map<K, A1It> a1p_;
	Am am_;
	std::unordered_map<K, AmIt> amp_;
	std::unordered_map<K, V> amv_;
	Out out_;
	std::unordered_map<K, OutIt> outp_;
~@

A1 里存 `pair<K,V>`，因为它可能带着值被访问；Am 和 out_ 只存 key，值在 `amv_` 里。三张 `key -> 迭代器` 的表各管一段，和前面几节的 `index_` 是同一类保证：list 节点不搬家，迭代器一直有效。

<< 更新 >>= @
	void trim_a1() {
		while (a1_.size() > ki_) {
			K k = std::move(a1_.front().first);
			a1p_.erase(k);
			a1_.pop_front();
			out_.push_back(k);              // 出去的不销毁，进影子
			outp_[k] = std::prev(out_.end());
			while (out_.size() > kout_) {   // 影子也有界
				outp_.erase(out_.front());
				out_.pop_front();
			}
		}
	}

	void trim_am() {
		while (am_.size() + ki_ > cap_) {   // Am 的配额是 cap - Ki
			K k = std::move(am_.back());
			amp_.erase(k);
			amv_.erase(k);
			am_.pop_back();
		}
	}

	void enter_am(const K& k, V v) {
		amv_[k] = std::move(v);
		am_.push_front(k);
		amp_[k] = am_.begin();
		trim_am();
	}

	void touch_am(const K& k) { am_.splice(am_.begin(), am_, amp_.at(k)); }
~@

`trim_a1` 是三件事的合流：A1 超配额、队头出队、出队的 key 进影子。注意它不删值——A1 的队头本来就是被挤出去的，值跟着 `pair` 一起销毁，影子只留 key。这一条是 2Q 空间省的来源。

<< get >>= @
	std::optional<V> get(const K& k) {
		if (amp_.count(k)) { touch_am(k); return amv_.at(k); } // 规则 3：热区，挪头
		auto p = a1p_.find(k);
		if (p == a1p_.end()) return std::nullopt;              // 规则 4
		V v = p->second->second;                               // 规则 3：二次访问
		a1_.erase(p->second);
		a1p_.erase(p);
		enter_am(k, v);                                        // 升到 Am
		return v;
	}
~@

<< put >>= @
	void put(const K& k, V v) {
		auto pa = amp_.find(k);
		if (pa != amp_.end()) {            // 规则 5：已在热区
			amv_[k] = std::move(v);
			touch_am(k);
			return;
		}
		auto p1 = a1p_.find(k);
		if (p1 != a1p_.end()) {            // 规则 6：同一 key 第二次写，升档
			a1_.erase(p1->second);
			a1p_.erase(p1);
			enter_am(k, std::move(v));
			return;
		}
		auto po = outp_.find(k);
		if (po != outp_.end()) {           // 准入：影子命中，直接进热区
			out_.erase(po->second);
			outp_.erase(po);
			enter_am(k, std::move(v));
			return;
		}
		a1_.push_back({k, std::move(v)});  // 全新：进候车室
		a1p_[k] = std::prev(a1_.end());
		trim_a1();
	}
~@

<< size >>= @
	std::size_t size() const { return am_.size() + a1_.size(); }
~@

<< capacity >>= @
	std::size_t capacity() const { return cap_; }
~@

拼装：

<< 2Q模型 >>= @
